# Caroline Loire — site statique Astro hébergé chez Hostinger (Apache / LiteSpeed)

# --- HTTPS + domaine canonique sans www -------------------------------------
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://carolineloire-energeticienne.fr%{REQUEST_URI} [L,R=301]

# --- Anciennes adresses WordPress → nouvelles pages (301) ---------------------
# Pages
Redirect 301 /energetique/ /soins-energetiques/
Redirect 301 /enseignement/ /formations-reiki/
Redirect 301 /tarifs-des-soins-energetiques-a-bagneres-de-bigorre/ /tarifs/
Redirect 301 /contactez-caroline-loire-a-bagneres-de-bigorre/ /contact/
Redirect 301 /a-propos-de-caroline-loire-a-bagneres-de-bigorre/ /a-propos/
Redirect 301 /les-oracles/ /oracles/
Redirect 301 /les-fleurs-de-bach/ /fleurs-de-bach/
Redirect 301 /politique-de-cookies-ue/ /politique-de-confidentialite/
# Boutique WooCommerce (séances, forfaits, carte cadeau) → tarifs
RedirectMatch 301 ^/(boutique|produit|categorie-produit|panier|commander|mon-compte)(/.*)?$ /tarifs/
# Blog de démonstration WordPress
RedirectMatch 301 ^/(2023|category|author)(/.*)?$ /
# Pages identiques sur l'ancien et le nouveau site (aucune redirection nécessaire) :
# /, /a-propos/, /chamanisme/, /reiki/, /tarifs/, /contact/, /mentions-legales/,
# /politique-de-confidentialite/

# --- Page 404 -----------------------------------------------------------------
ErrorDocument 404 /404.html

# --- Cache navigateur ---------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  # Le HTML est toujours revalidé : sans cela, une modification publiée
  # depuis le CMS n'apparaît pas chez les visiteurs déjà venus sur le site.
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

# --- En-têtes de sécurité -----------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Ceinture et bretelles avec le bloc mod_expires ci-dessus : les pages HTML
  # sont revérifiées à chaque visite, les fichiers construits (empreinte dans
  # le nom) restent en cache longtemps.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
