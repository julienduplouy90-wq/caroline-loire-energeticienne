---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { IMG, INDEXABLE, SITE, asset } from '../data/site';
import { ANALYTICS } from '../data/analytics';
import { GHL } from '../data/ghl';

interface Props {
  title: string;
  description: string;
  image?: string;
  /** JSON-LD supplémentaire injecté dans le <head>. */
  jsonLd?: Record<string, unknown>;
}

const { title, description, image = IMG.caroline, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!INDEXABLE && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href={asset('favicon.png')} />
    <link rel="apple-touch-icon" href={asset('images/monogram.png')} />
    <meta name="theme-color" content="#4DA0A8" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap"
    />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    {
      /* Google Analytics 4 — chargé uniquement si un identifiant est renseigné
         dans src/data/analytics.ts (et qu'une bannière de consentement existe). */
      ANALYTICS.gaMeasurementId && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${ANALYTICS.gaMeasurementId}`}
          />
          <script is:inline define:vars={{ gaId: ANALYTICS.gaMeasurementId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', gaId, { anonymize_ip: true });
          </script>
        </>
      )
    }
  </head>
  <body class="min-h-dvh bg-white text-ink">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-forest focus:px-4 focus:py-2 focus:text-sm focus:text-white"
    >
      Aller au contenu
    </a>
    <Header />
    <main id="contenu" class="pb-20 md:pb-0"><slot /></main>
    <Footer />
    <MobileBar />

    <script is:inline>
      /* Suivi des conversions — indépendant de l'outil de mesure.
         Tout élément portant `data-track="nom_evenement"` émet l'événement au
         clic ; `window.clTrack(nom, params)` permet de l'émettre à la main
         (ex. formulaire envoyé). GA4 (gtag), GTM (dataLayer) et Meta Pixel
         (fbq) le reçoivent s'ils sont installés. */
      (function () {
        window.dataLayer = window.dataLayer || [];
        function track(name, params) {
          if (!name) return;
          var data = Object.assign({ event: name }, params || {});
          if (typeof window.gtag === 'function') window.gtag('event', name, params || {});
          else window.dataLayer.push(data);
          if (typeof window.fbq === 'function') window.fbq('trackCustom', name, params || {});
        }
        window.clTrack = track;
        document.addEventListener('click', function (e) {
          var el = e.target && e.target.closest ? e.target.closest('[data-track]') : null;
          if (!el) return;
          track(el.getAttribute('data-track'), {
            label: el.getAttribute('data-track-label') || undefined,
            page: location.pathname,
            destination: el.getAttribute('href') || undefined,
          });
        });
      })();
    </script>

    <script>
      const targets = document.querySelectorAll('[data-reveal]');
      const revealAll = () => targets.forEach((el) => el.classList.add('is-visible'));

      if (targets.length && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        targets.forEach((el) => io.observe(el));

        // Filet de sécurité : si l'observer ne se déclenche jamais (onglet en
        // arrière-plan, moteur de rendu sans compositing, extension), le contenu
        // doit rester visible malgré tout.
        setTimeout(() => {
          io.disconnect();
          revealAll();
        }, 2500);
      } else {
        revealAll();
      }
    </script>

    {
      /* Widget de discussion GoHighLevel (bulle en bas à droite).
         Identifiant dans src/data/ghl.ts — le vider retire la bulle. */
      GHL.chatWidgetId && (
        <script
          is:inline
          src="https://widgets.leadconnectorhq.com/loader.js"
          data-resources-url="https://widgets.leadconnectorhq.com/chat-widget/loader.js"
          data-widget-id={GHL.chatWidgetId}
        />
      )
    }
  </body>
</html>
