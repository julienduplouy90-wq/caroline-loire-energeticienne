---
import { IMG, NAV, SITE, u } from '../data/site';

const current = Astro.url.pathname.replace(/\/+$/, '') || u('/').replace(/\/+$/, '');
const isActive = (to: string) => {
  const href = u(to).replace(/\/+$/, '');
  return current === href;
};
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-40 border-b border-transparent transition-all duration-300"
>
  <div class="flex w-full items-center justify-between gap-4 px-4 py-3 md:px-6 lg:px-8">
    <a href={u('/')} class="flex shrink-0 items-center gap-2.5" data-close-menu>
      <img
        src={IMG.monogram}
        alt=""
        class="h-10 w-10 rounded-full object-cover"
        width="40"
        height="40"
      />
      <span class="font-display tracking-logo text-lg text-forest md:text-xl">CAROLINE LOIRE</span>
    </a>

    <nav class="hidden items-center gap-1 whitespace-nowrap lg:flex" aria-label="Navigation principale">
      {
        NAV.map((item) => (
          <a
            href={u(item.to)}
            aria-current={isActive(item.to) ? 'page' : undefined}
            class:list={[
              'rounded-full px-3 py-2 text-[0.8rem] font-medium tracking-wide transition-colors',
              isActive(item.to)
                ? 'bg-forest/15 text-forest shadow-[inset_0_-2px_0_0_var(--color-peach)]'
                : 'text-ink/75 hover:bg-sand hover:text-forest',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={u(SITE.bookingPath)}
        class="hidden rounded-full bg-forest px-4 py-2.5 text-sm font-medium text-white shadow-sm transition hover:bg-forest-deep sm:inline-flex"
      >
        Prendre rendez-vous
      </a>
      <button
        type="button"
        id="menu-toggle"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-line bg-white text-forest lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Ouvrir le menu"
      >
        <svg class="h-5 w-5" data-icon="open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="hidden h-5 w-5" data-icon="close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="hidden border-t border-line bg-white lg:hidden">
    <nav class="flex w-full flex-col gap-1 px-4 py-4" aria-label="Menu mobile">
      {
        NAV.map((item) => (
          <a
            href={u(item.to)}
            data-close-menu
            aria-current={isActive(item.to) ? 'page' : undefined}
            class:list={[
              'rounded-xl px-4 py-3 text-base font-medium',
              isActive(item.to) ? 'bg-forest/15 text-forest' : 'text-ink hover:bg-sand',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={u(SITE.bookingPath)}
        data-close-menu
        class="mt-2 rounded-full bg-forest px-4 py-3 text-center text-base font-medium text-white"
      >
        Prendre rendez-vous
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const panel = document.getElementById('mobile-nav');

  const paint = () => {
    if (!header) return;
    const solid = window.scrollY > 12 || panel?.classList.contains('is-open');
    header.classList.toggle('bg-white/95', Boolean(solid));
    header.classList.toggle('backdrop-blur-md', Boolean(solid));
    header.classList.toggle('shadow-sm', Boolean(solid));
    header.classList.toggle('border-line', Boolean(solid));
  };

  const setOpen = (open: boolean) => {
    if (!toggle || !panel) return;
    panel.classList.toggle('hidden', !open);
    panel.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    toggle.querySelector<SVGElement>('[data-icon="open"]')?.classList.toggle('hidden', open);
    toggle.querySelector<SVGElement>('[data-icon="close"]')?.classList.toggle('hidden', !open);
    document.body.style.overflow = open ? 'hidden' : '';
    paint();
  };

  toggle?.addEventListener('click', () => setOpen(panel?.classList.contains('hidden') ?? true));
  document.querySelectorAll('[data-close-menu]').forEach((el) => el.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
  window.addEventListener('scroll', paint, { passive: true });
  paint();
</script>
