---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  image?: string;
  imageAlt?: string;
}

const { eyebrow, title, text, image, imageAlt = '' } = Astro.props;
---

<section class="relative overflow-hidden border-b border-line/70 bg-sand/60 pt-28 pb-12 md:pt-32 md:pb-16">
  <div class="mx-auto grid max-w-6xl items-end gap-8 px-4 md:grid-cols-12 md:px-6">
    <div class={image ? 'md:col-span-7' : 'md:col-span-10'}>
      {
        eyebrow && (
          <p class="flex items-center gap-2.5 text-xs font-semibold tracking-[0.2em] text-peach-deep uppercase">
            <span class="accent-bar" aria-hidden="true" />
            {eyebrow}
          </p>
        )
      }
      <h1 class="font-display mt-3 text-4xl leading-[1.12] font-medium text-forest md:text-5xl lg:text-[3.25rem]">
        {title}
      </h1>
      {text && <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink/80 md:text-lg">{text}</p>}
    </div>
    {
      image && (
        <div class="md:col-span-5" data-reveal>
          <div class="overflow-hidden rounded-3xl shadow-lg ring-1 ring-line/70">
            <img src={image} alt={imageAlt} class="aspect-[4/3] w-full object-cover" loading="eager" />
          </div>
        </div>
      )
    }
  </div>
</section>
