---
/*
 * Section « Premier échange » : le formulaire GoHighLevel embarqué sur
 * l'accueil. Restitution à l'identique de ce qui était en ligne avant le
 * déploiement du 28/08/2026 (le code source n'existait pas dans le dépôt).
 * Les identifiants vivent dans src/data/ghl.ts : si `form` est vidé, la
 * section disparaît sans rien casser.
 */
import { GHL, GHL_FORM_SRC } from '../data/ghl';
import { TRACK } from '../data/systeme';
---

{
  GHL_FORM_SRC && (
    <section id="premier-echange" aria-labelledby="premier-echange-titre">
      <div class="premier-echange__inner">
        <div>
          <p class="premier-echange__eyebrow">Premier échange</p>
          <h2 id="premier-echange-titre">Parlons de ce qui vous amène</h2>
          <p class="premier-echange__text">
            Vous pouvez laisser vos coordonnées et quelques mots sur votre situation. Caroline vous
            répondra avec attention pour vous orienter vers l’accompagnement le plus juste pour
            vous.
          </p>
          <ul class="premier-echange__points">
            <li>Une réponse personnelle et bienveillante</li>
            <li>Aucun engagement après votre demande</li>
            <li>Vos informations restent confidentielles</li>
          </ul>
          {GHL.booking && (
            <a
              class="premier-echange__direct"
              href={GHL.booking}
              data-track={TRACK.booking}
              data-track-label="formulaire-premier-echange"
            >
              Vous préférez choisir un créneau directement ?
            </a>
          )}
        </div>
        <div class="premier-echange__card">
          <h3>Faites le premier pas, à votre rythme</h3>
          <p>
            Répondez simplement à ces quelques questions. Les champs marqués d’un astérisque sont
            nécessaires pour vous recontacter.
          </p>
          <iframe
            src={GHL_FORM_SRC}
            title="Formulaire de premier échange avec Caroline Loire"
            loading="lazy"
          />
        </div>
      </div>
    </section>
  )
}

<style>
  #premier-echange {
    background: #f7fbfb;
    padding: 84px 24px;
  }
  #premier-echange .premier-echange__inner {
    max-width: 1152px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
    gap: 48px;
    align-items: center;
  }
  #premier-echange .premier-echange__eyebrow {
    margin: 0 0 12px;
    color: #b2633d;
    font: 600 12px/1.4 Inter, sans-serif;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  #premier-echange h2 {
    margin: 0;
    color: #4da0a8;
    font: 600 clamp(32px, 4vw, 48px) / 1.15 Poppins, sans-serif;
  }
  #premier-echange .premier-echange__text {
    max-width: 510px;
    margin: 22px 0 0;
    color: #344054;
    font: 400 17px/1.7 Inter, sans-serif;
  }
  #premier-echange .premier-echange__points {
    display: grid;
    gap: 13px;
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
    color: #344054;
    font: 500 15px/1.45 Inter, sans-serif;
  }
  #premier-echange .premier-echange__points li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  #premier-echange .premier-echange__points li::before {
    content: '✓';
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #e7f2f3;
    color: #4da0a8;
    font-weight: 700;
  }
  #premier-echange .premier-echange__direct {
    display: inline-block;
    margin-top: 28px;
    color: #4da0a8;
    font: 600 15px/1.4 Inter, sans-serif;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  #premier-echange .premier-echange__card {
    background: #fff;
    border: 1px solid #e8e4e1;
    border-radius: 24px;
    padding: 28px;
    box-shadow: 0 16px 42px rgba(54, 92, 94, 0.1);
  }
  #premier-echange .premier-echange__card h3 {
    margin: 0;
    color: #344054;
    font: 600 23px/1.3 Poppins, sans-serif;
  }
  #premier-echange .premier-echange__card p {
    margin: 8px 0 18px;
    color: #667085;
    font: 400 14px/1.55 Inter, sans-serif;
  }
  #premier-echange iframe {
    display: block;
    width: 100%;
    height: 770px;
    border: 0;
    background: #fff;
  }
  @media (max-width: 767px) {
    #premier-echange {
      padding: 58px 16px;
    }
    #premier-echange .premier-echange__inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    #premier-echange .premier-echange__card {
      padding: 20px 14px;
    }
    #premier-echange iframe {
      height: 805px;
    }
  }
</style>
