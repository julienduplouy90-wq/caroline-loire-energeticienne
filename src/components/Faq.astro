---
interface Props {
  items: { q: string; a: string }[];
}

const { items } = Astro.props;
---

<div class="mt-6 divide-y divide-line md:mt-8">
  {
    items.map((item) => (
      <details class="group border-l-2 border-l-peach/60 py-1 pl-4">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-left text-base font-medium text-forest">
          {item.q}
          <svg
            class="h-4 w-4 shrink-0 transition-transform group-open:rotate-180"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <p class="pb-4 text-sm leading-relaxed text-ink/80">{item.a}</p>
      </details>
    ))
  }
</div>
