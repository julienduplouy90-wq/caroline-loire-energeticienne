---
import { IMG, NAV_FULL, RESOURCES, SITE, u } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-forest text-white">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 md:grid-cols-12 md:px-6 md:py-16">
    <div class="md:col-span-4">
      <div class="flex items-center gap-3">
        <img
          src={IMG.monogramClair}
          alt=""
          class="h-14 w-14 shrink-0 object-contain"
          width="56"
          height="56"
          loading="lazy"
        />
        <div>
          <img
            src={IMG.logoClair}
            alt={SITE.name}
            class="h-11 w-auto"
            width="1128"
            height="376"
            loading="lazy"
          />
          <p class="mt-2 text-sm text-white/75">{SITE.tagline}</p>
        </div>
      </div>
      <p class="mt-5 max-w-sm text-sm leading-relaxed text-white/80">
        Accompagnements énergétiques, séances de chamanisme et formations Reiki à {SITE.city}, dans
        les {SITE.region}.
      </p>
      <div class="mt-5 flex gap-3">
        <a
          href={SITE.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-peach transition hover:bg-white/20"
          aria-label="Instagram de Caroline Loire"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
          </svg>
        </a>
        <a
          href={SITE.facebook}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-peach transition hover:bg-white/20"
          aria-label="Page Facebook de Caroline Loire"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M13.5 22v-8h2.7l.4-3.1h-3.1V8.9c0-.9.25-1.5 1.55-1.5h1.65V4.6c-.3 0-1.3-.1-2.45-.1-2.4 0-4.05 1.5-4.05 4.2v2.2H7.5V14h2.7v8h3.3Z" />
          </svg>
        </a>
      </div>
    </div>

    <div class="md:col-span-2">
      <p class="text-xs font-semibold tracking-[0.18em] text-peach uppercase">Navigation</p>
      <ul class="mt-4 space-y-2 text-sm">
        {
          NAV_FULL.map((item) => (
            <li>
              <a href={u(item.to)} class="text-white/85 transition hover:text-white">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="md:col-span-3">
      <p class="text-xs font-semibold tracking-[0.18em] text-peach uppercase">Ressources</p>
      <ul class="mt-4 grid grid-cols-2 gap-x-3 gap-y-2 text-sm">
        {
          RESOURCES.map((item) => (
            <li>
              <a href={u(item.to)} class="text-white/85 transition hover:text-white">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="md:col-span-3">
      <p class="text-xs font-semibold tracking-[0.18em] text-peach uppercase">Contact</p>
      <ul class="mt-4 space-y-3 text-sm text-white/90">
        <li class="flex gap-2">
          <svg class="mt-0.5 h-4 w-4 shrink-0 text-peach" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" />
          </svg>
          <span>{SITE.fullAddress}</span>
        </li>
        <li class="flex gap-2">
          <svg class="mt-0.5 h-4 w-4 shrink-0 text-peach" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" />
          </svg>
          <a href={SITE.phoneHref} class="hover:text-white">{SITE.phone}</a>
        </li>
        <li class="flex gap-2">
          <svg class="mt-0.5 h-4 w-4 shrink-0 text-peach" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9 9 0 0 1-3.4-.7L3 21l1.9-5A8.2 8.2 0 0 1 4 11.5a8.4 8.4 0 0 1 9-8.4 8.4 8.4 0 0 1 8 8.4Z" />
          </svg>
          <span>
            <a href={SITE.smsHref} class="hover:text-white">Envoyer un SMS</a> — je réponds
            facilement aux SMS.
          </span>
        </li>
        <li class="flex gap-2">
          <svg class="mt-0.5 h-4 w-4 shrink-0 text-peach" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2" /><path d="m2 7 10 6 10-6" />
          </svg>
          <span>
            <a href={u('/contact')} class="hover:text-white">Écrire par le formulaire</a>
          </span>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div
      class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-5 text-xs text-white/65 md:flex-row md:items-center md:justify-between md:px-6"
    >
      <p>© {year} {SITE.name} — {SITE.city}</p>
      <div class="flex flex-wrap gap-4">
        <a href={u('/mentions-legales')} class="hover:text-white">Mentions légales</a>
        <a href={u('/politique-de-confidentialite')} class="hover:text-white">Confidentialité</a>
        <a href={u('/ressources')} class="hover:text-white">Ressources</a>
      </div>
    </div>
  </div>
</footer>
