---
import { SITE } from '../data/site';
import { TRACK, systemeHref } from '../data/systeme';
---

<div
  class="fixed inset-x-0 bottom-0 z-40 bg-forest px-3 py-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] shadow-[0_-8px_24px_rgba(17,17,17,0.18)] md:hidden"
>
  <div class="mx-auto grid max-w-lg grid-cols-2 gap-2">
    <a
      href={SITE.phoneHref}
      class="inline-flex h-12 items-center justify-center gap-2 rounded-full bg-white text-sm font-semibold text-ink transition hover:bg-peach"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" />
      </svg>
      Appeler
    </a>
    <a
      href={systemeHref('booking', SITE.bookingPath, 'barre-mobile')}
      data-track={TRACK.booking}
      data-track-label="barre-mobile"
      class="inline-flex h-12 items-center justify-center gap-2 rounded-full bg-peach text-sm font-semibold text-ink transition hover:bg-white"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <rect x="3" y="5" width="18" height="16" rx="2" /><path d="M8 3v4M16 3v4M3 11h18" />
      </svg>
      Prendre RDV
    </a>
  </div>
</div>
