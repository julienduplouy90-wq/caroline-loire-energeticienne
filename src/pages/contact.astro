---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { IMG, SITE, u } from '../data/site';
import { SYSTEME_CONTACT_FORM_EMBED, TRACK, hasSysteme, systemeHref } from '../data/systeme';

const title = 'Contact | Caroline Loire énergéticienne à Bagnères-de-Bigorre';
const description = `Contactez Caroline Loire à Bagnères-de-Bigorre : ${SITE.phone}, ${SITE.email}, ${SITE.address}.`;

const subjects = [
  'Demande d’informations',
  'Soin énergétique',
  'Chamanisme',
  'Formation Reiki',
  'Autre',
];

const onlineBooking = hasSysteme('booking');
const bookingHref = systemeHref('booking', SITE.bookingPath, 'contact');

const mapSrc =
  'https://maps.google.com/maps?q=20%20rue%20Justin%20Dal%C3%A9as%2C%2065200%20Bagn%C3%A8res-de-Bigorre&z=16&output=embed';
---

<BaseLayout title={title} description={description} image={IMG.carte}>
  <PageHero
    eyebrow="Contact"
    title="Vous n’avez pas besoin d’avoir toutes les réponses pour faire le premier pas"
    text="Écrivez-moi quelques mots sur ce que vous traversez, ou appelez-moi directement. Je vous répondrai avec simplicité."
  />

  <section class="px-4 py-14 md:px-6 md:py-16">
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-12">
      <div class="space-y-6 lg:col-span-4">
        <div class="rounded-3xl border border-line bg-white p-6">
          <h2 class="font-display text-2xl text-forest">Coordonnées</h2>
          <span class="accent-bar mt-3" aria-hidden="true"></span>
          <ul class="mt-5 space-y-4 text-sm text-ink/85">
            <li class="flex gap-3">
              <svg
                class="mt-0.5 h-4 w-4 shrink-0 text-peach-deep"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"
              >
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle
                  cx="12"
                  cy="10"
                  r="3"></circle>
              </svg>
              <span>Caroline Loire<br />{SITE.fullAddress}</span>
            </li>
            <li class="flex gap-3">
              <svg
                class="mt-0.5 h-4 w-4 shrink-0 text-peach-deep"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"
              >
                <path
                  d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"
                ></path>
              </svg>
              <a href={SITE.phoneHref} class="font-medium text-forest hover:underline"
                >{SITE.phone}</a
              >
            </li>
            <li class="flex gap-3">
              <svg
                class="mt-0.5 h-4 w-4 shrink-0 text-peach-deep"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"
              >
                <rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m2 7 10 6 10-6"
                ></path>
              </svg>
              <a href={SITE.emailHref} class="font-medium break-all text-forest hover:underline"
                >{SITE.email}</a
              >
            </li>
          </ul>
          {
            onlineBooking ? (
              <>
                <p class="mt-6 rounded-2xl bg-sand/70 px-4 py-3 text-xs leading-relaxed text-slate-soft">
                  Vous pouvez réserver votre séance directement en ligne, ou m’appeler si vous
                  préférez échanger de vive voix.
                </p>
                <a
                  href={bookingHref}
                  data-track={TRACK.booking}
                  data-track-label="contact"
                  class="mt-4 flex min-h-12 items-center justify-center rounded-full bg-forest text-sm font-medium text-white transition hover:bg-forest-deep"
                >
                  Réserver en ligne
                </a>
                <a
                  href={SITE.phoneHref}
                  class="mt-3 flex min-h-11 items-center justify-center rounded-full border border-forest/25 text-sm font-medium text-forest transition hover:bg-sand"
                >
                  Appeler Caroline
                </a>
              </>
            ) : (
              <>
                <p class="mt-6 rounded-2xl bg-sand/70 px-4 py-3 text-xs leading-relaxed text-slate-soft">
                  Les rendez-vous se prennent par téléphone ou par e-mail. Je vous rappelle dès que
                  possible pour convenir d’un créneau.
                </p>
                <a
                  href={SITE.phoneHref}
                  class="mt-4 flex min-h-12 items-center justify-center rounded-full bg-forest text-sm font-medium text-white transition hover:bg-forest-deep"
                >
                  Appeler Caroline
                </a>
              </>
            )
          }
        </div>

        <div class="overflow-hidden rounded-3xl border border-line bg-white shadow-sm">
          <iframe
            title="Carte du cabinet de Caroline Loire à Bagnères-de-Bigorre"
            src={mapSrc}
            class="aspect-[4/3] w-full border-0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen></iframe>
          <p class="border-t border-line px-4 py-3 text-xs leading-relaxed text-slate-soft">
            {SITE.fullAddress}
          </p>
        </div>
      </div>

      <div class="lg:col-span-8">
        {
          SYSTEME_CONTACT_FORM_EMBED ? (
            /* Formulaire Systeme.io embarqué : le contact arrive directement
               dans le CRM (tag `prospect-contact`) et déclenche le workflow
               « Prospect sans rendez-vous ». Style à régler dans Systeme.io
               (voir docs/systeme-io/charte.md). */
            <div
              id="contact-form-systeme"
              class="rounded-3xl border border-line bg-white p-6 md:p-8"
              data-track-form={TRACK.formSent}
            >
              <h2 class="font-display text-2xl text-forest">Écrire un message</h2>
              <span class="accent-bar mt-3" aria-hidden="true" />
              <p class="mt-2 text-sm text-slate-soft">
                Aucun renseignement médical sensible n’est demandé.
              </p>
              <div class="mt-6" set:html={SYSTEME_CONTACT_FORM_EMBED} />
            </div>
          ) : (
        <form
          id="contact-form"
          class="rounded-3xl border border-line bg-white p-6 md:p-8"
          method="post"
          action={SITE.formEndpoint || undefined}
        >
          <h2 class="font-display text-2xl text-forest">Écrire un message</h2>
          <span class="accent-bar mt-3" aria-hidden="true"></span>
          <p class="mt-2 text-sm text-slate-soft">
            Aucun renseignement médical sensible n’est demandé.
          </p>

          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            <label class="block text-sm">
              <span class="font-medium text-forest">Prénom *</span>
              <input
                required
                name="prenom"
                autocomplete="given-name"
                class="mt-1.5 w-full rounded-xl border border-line bg-white px-3 py-2.5 outline-none focus:border-forest focus:ring-2 focus:ring-forest/40"
              />
            </label>
            <label class="block text-sm">
              <span class="font-medium text-forest">Nom *</span>
              <input
                required
                name="nom"
                autocomplete="family-name"
                class="mt-1.5 w-full rounded-xl border border-line bg-white px-3 py-2.5 outline-none focus:border-forest focus:ring-2 focus:ring-forest/40"
              />
            </label>
            <label class="block text-sm">
              <span class="font-medium text-forest">E-mail *</span>
              <input
                required
                type="email"
                name="email"
                autocomplete="email"
                class="mt-1.5 w-full rounded-xl border border-line bg-white px-3 py-2.5 outline-none focus:border-forest focus:ring-2 focus:ring-forest/40"
              />
            </label>
            <label class="block text-sm">
              <span class="font-medium text-forest"
                >Téléphone <span class="font-normal text-slate-soft">(facultatif)</span></span
              >
              <input
                name="telephone"
                autocomplete="tel"
                class="mt-1.5 w-full rounded-xl border border-line bg-white px-3 py-2.5 outline-none focus:border-forest focus:ring-2 focus:ring-forest/40"
              />
            </label>
          </div>

          <label class="mt-4 block text-sm">
            <span class="font-medium text-forest">Objet de la demande *</span>
            <select
              name="objet"
              class="mt-1.5 w-full rounded-xl border border-line bg-white px-3 py-2.5 outline-none focus:border-forest focus:ring-2 focus:ring-forest/40"
            >
              {subjects.map((s) => <option value={s}>{s}</option>)}
            </select>
          </label>

          <label class="mt-4 block text-sm">
            <span class="font-medium text-forest">Message *</span>
            <textarea
              required
              name="message"
              rows="6"
              class="mt-1.5 w-full resize-y rounded-xl border border-line bg-white px-3 py-2.5 outline-none focus:border-forest focus:ring-2 focus:ring-forest/40"
            ></textarea>
          </label>

          <label class="mt-4 flex items-start gap-3 text-sm text-ink/80">
            <input
              required
              type="checkbox"
              name="consentement"
              value="oui"
              class="mt-1 h-4 w-4 rounded border-line"
            />
            <span>
              J’accepte que mes données soient utilisées pour répondre à ma demande, conformément à
              la <a href={u('/politique-de-confidentialite')} class="underline"
                >politique de confidentialité</a
              >.
            </span>
          </label>

          <label class="mt-3 flex items-start gap-3 text-sm text-ink/80">
            <input
              type="checkbox"
              name="nouvelles"
              value="oui"
              class="mt-1 h-4 w-4 rounded border-line"
            />
            <span>
              J’accepte de recevoir occasionnellement des nouvelles de Caroline (dates de
              formations, actualités du cabinet). Facultatif, désinscription possible à tout moment.
            </span>
          </label>

          <!-- Piège à robots : laissé vide par les humains. -->
          <div class="hidden" aria-hidden="true">
            <label>Ne pas remplir<input name="_gotcha" tabindex="-1" autocomplete="off" /></label>
          </div>

          <p id="form-status" class="mt-4 hidden text-sm" role="status"></p>

          <button
            type="submit"
            class="mt-6 inline-flex min-h-12 items-center justify-center rounded-full bg-forest px-7 py-3 text-sm font-medium text-white transition hover:bg-forest-deep disabled:opacity-60"
          >
            Envoyer le message
          </button>
        </form>
          )
        }
      </div>
    </div>
  </section>

  <script define:vars={{ endpoint: SITE.formEndpoint, mailto: SITE.email, sentEvent: TRACK.formSent }}>
    const form = document.getElementById('contact-form');
    const status = document.getElementById('form-status');
    const sent = (mode, objet) =>
      typeof window.clTrack === 'function' && window.clTrack(sentEvent, { mode, objet });

    const show = (message, ok) => {
      if (!status) return;
      status.textContent = message;
      status.classList.remove('hidden');
      status.classList.toggle('text-forest', Boolean(ok));
      status.classList.toggle('text-peach-deep', !ok);
    };

    form?.addEventListener('submit', async (event) => {
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      if (data.get('_gotcha')) {
        event.preventDefault();
        return;
      }

      // Sans endpoint configuré, on ouvre le logiciel de messagerie du visiteur
      // avec un message pré-rempli : le site reste 100 % statique.
      if (!endpoint) {
        event.preventDefault();
        const corps = [
          `Prénom : ${data.get('prenom')}`,
          `Nom : ${data.get('nom')}`,
          `E-mail : ${data.get('email')}`,
          `Téléphone : ${data.get('telephone') || '—'}`,
          `Recevoir des nouvelles : ${data.get('nouvelles') ? 'oui' : 'non'}`,
          '',
          data.get('message'),
        ].join('\n');
        const href = `mailto:${mailto}?subject=${encodeURIComponent(
          `[Site] ${data.get('objet')}`,
        )}&body=${encodeURIComponent(corps)}`;
        window.location.href = href;
        sent('mailto', data.get('objet'));
        show('Votre logiciel de messagerie s’ouvre avec le message pré-rempli.', true);
        return;
      }

      event.preventDefault();
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error('HTTP ' + res.status);
        form.reset();
        sent('formspree', data.get('objet'));
        show('Message envoyé. Merci, je vous répondrai dès que possible.', true);
      } catch {
        show(
          `L’envoi a échoué. Vous pouvez m’écrire directement à ${mailto} ou m’appeler.`,
          false,
        );
      }
    });
  </script>
</BaseLayout>
