---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { RESOURCES, u } from '../data/site';

const title = 'Ressources | Pratiques complémentaires — Caroline Loire';
const description =
  'Pages pédagogiques sur le Reiki, Shamballa, LaHoChi, lithothérapie, radiesthésie, oracles, Fleurs de Bach et hypnose.';
---

<BaseLayout title={title} description={description}>
  <PageHero
    eyebrow="Ressources"
    title="Comprendre les outils qui peuvent nourrir une séance"
    text="Ces pages expliquent les pratiques qui peuvent être présentes dans un soin énergétique ou une séance de chamanisme. Elles font partie d’un même accompagnement."
  />

  <section class="px-4 py-14 md:px-6">
    <ul class="mx-auto grid max-w-4xl gap-3 sm:grid-cols-2">
      {
        RESOURCES.map((r) => (
          <li>
            <a
              href={u(r.to)}
              class="flex min-h-14 items-center rounded-2xl border border-line border-l-2 border-l-peach bg-white px-5 py-4 text-forest transition hover:border-peach hover:bg-peach/15"
            >
              {r.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
