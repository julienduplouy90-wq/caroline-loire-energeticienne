---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { IMG, PRICES, SITE, u } from '../data/site';
import { TRACK, systemeHref } from '../data/systeme';
import page from '../data/pages/tarifs.json';

const title = 'Tarifs des soins énergétiques à Bagnères-de-Bigorre | Caroline Loire';
const description =
  'Tarifs des soins énergétiques, séances de chamanisme et formations Reiki à Bagnères-de-Bigorre. Tarifs solidaires disponibles.';

const presentiel = [
  {
    seance: 'Séance énergies',
    duree: PRICES.soin.duration,
    tarif: `${PRICES.soin.full} €`,
    solidaire: `${PRICES.soin.solidaire} € solidaire`,
  },
  {
    seance: 'Séance énergies enfant',
    duree: PRICES.soinEnfant.duration,
    tarif: `${PRICES.soinEnfant.full} €`,
    solidaire: '',
  },
  {
    seance: 'Chamanisme et énergies',
    duree: PRICES.chamanisme.duration,
    tarif: `${PRICES.chamanisme.full} €`,
    solidaire: `${PRICES.chamanisme.solidaire} € solidaire`,
  },
  {
    seance: 'Chamanisme et énergies enfant',
    duree: PRICES.chamanismeEnfant.duration,
    tarif: `${PRICES.chamanismeEnfant.full} €`,
    solidaire: '',
  },
];

const distance = [
  {
    seance: 'Séance énergies (1 h / 1 h 30)',
    tarif: `${PRICES.soin.full} € (${PRICES.soin.solidaire} € solidaire)`,
  },
  {
    seance: 'Chamanisme et énergies (format plus court, 1 h / 1 h 30)',
    tarif: `${PRICES.soin.full} € (${PRICES.soin.solidaire} € solidaire)`,
  },
];

const formations = [
  { label: '1er degré', price: PRICES.reiki1 },
  { label: '2e degré', price: PRICES.reiki2 },
  { label: '3e degré', price: PRICES.reiki3 },
];
---

<BaseLayout title={title} description={description} image={IMG.carte}>
  <PageHero eyebrow={page.surtitre} title={page.titre} text={page.texte} />

  <section class="px-4 py-12 md:px-6">
    <div
      class="mx-auto max-w-3xl rounded-3xl border border-line border-t-2 border-t-peach bg-sand/50 p-6 md:p-8"
    >
      <span class="accent-bar mb-4" aria-hidden="true"></span>
      <h2 class="font-display text-2xl text-forest">Tarif complet et tarif solidaire</h2>
      <p class="mt-3 text-base leading-relaxed text-ink/80">
        Pour certaines séances, deux tarifs sont proposés : le tarif complet, correspondant à la
        valeur réelle du soin, et le tarif solidaire, destiné à celles et ceux pour qui le tarif
        complet représenterait un frein. Aucune justification ne vous sera demandée. Merci à toutes
        les personnes qui choisissent le tarif complet — elles permettent à cette démarche de
        continuer.
      </p>
      <p class="mt-3 text-sm text-slate-soft">
        Paiements en plusieurs fois possibles.
      </p>
    </div>
  </section>

  <section class="px-4 pb-16 md:px-6">
    <div class="mx-auto max-w-6xl space-y-10">
      <div>
        <h2 class="font-display text-2xl text-forest">Présentiel</h2>
        <div class="mt-5 overflow-x-auto rounded-2xl border border-line">
          <table class="w-full min-w-[32rem] text-left text-sm">
            <thead class="bg-peach/25 text-forest">
              <tr>
                <th scope="col" class="px-4 py-3 font-medium">Séance</th>
                <th scope="col" class="px-4 py-3 font-medium">Durée</th>
                <th scope="col" class="px-4 py-3 font-medium">Tarif</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line bg-white">
              {
                presentiel.map((r) => (
                  <tr>
                    <td class="px-4 py-3">{r.seance}</td>
                    <td class="px-4 py-3">{r.duree}</td>
                    <td class="px-4 py-3">
                      {r.tarif}
                      {r.solidaire && <span class="text-slate-soft"> ({r.solidaire})</span>}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <div>
        <h2 class="font-display text-2xl text-forest">À distance</h2>
        <div class="mt-5 overflow-x-auto rounded-2xl border border-line">
          <table class="w-full min-w-[32rem] text-left text-sm">
            <thead class="bg-peach/25 text-forest">
              <tr>
                <th scope="col" class="px-4 py-3 font-medium">Séance</th>
                <th scope="col" class="px-4 py-3 font-medium">Tarif</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line bg-white">
              {
                distance.map((r) => (
                  <tr>
                    <td class="px-4 py-3">{r.seance}</td>
                    <td class="px-4 py-3">{r.tarif}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="mt-3 text-sm text-slate-soft">
          À distance : échange téléphonique, puis vous vous allongez chez vous pendant le travail ;
          rappel en fin de séance.
        </p>
      </div>

      <div>
        <h2 class="font-display text-2xl text-forest">Formations Reiki</h2>
        <ul class="mt-5 grid gap-3 sm:grid-cols-3">
          {
            formations.map((f) => (
              <li class="rounded-2xl border border-line border-t-2 border-t-peach bg-white p-5">
                <p class="text-sm text-slate-soft">{f.label}</p>
                <p class="font-display mt-1 text-3xl text-forest">{f.price} €</p>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="flex flex-wrap gap-3">
        <a
          href={systemeHref('booking', SITE.bookingPath, 'tarifs')}
          data-track={TRACK.booking}
          data-track-label="tarifs"
          class="inline-flex min-h-12 items-center rounded-full bg-forest px-6 py-3 text-sm font-medium text-white transition hover:bg-forest-deep"
        >
          Prendre rendez-vous
        </a>
        <a
          href={SITE.phoneHref}
          class="inline-flex min-h-12 items-center rounded-full border border-forest/25 px-6 py-3 text-sm font-medium text-forest hover:bg-sand"
        >
          Appeler le {SITE.phone}
        </a>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
