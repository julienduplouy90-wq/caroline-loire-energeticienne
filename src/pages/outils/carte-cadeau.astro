---
/*
 * Générateur de cartes cadeaux — outil privé de Caroline.
 *
 * Jusqu'ici, Caroline envoyait un PDF que les clients devaient remplir
 * eux-mêmes. Ici, elle remplit le formulaire, la carte se compose sous
 * ses yeux dans la charte du site, et « Imprimer / PDF » produit le
 * fichier qu'elle envoie ou imprime. Tout se passe dans le navigateur :
 * aucune donnée n'est envoyée nulle part.
 *
 * La page n'est reliée à aucun menu, exclue du sitemap (astro.config.mjs)
 * et en noindex : seule Caroline (et Julien) en connaissent l'adresse.
 *
 * Le code inscrit sur la carte est un repère : pour qu'il fonctionne aussi
 * comme code promo d'une réservation en ligne, il doit être créé dans
 * l'outil de réservation (GoHighLevel → Paiements → Coupons).
 */
import '../../styles/global.css';
import { IMG, SITE } from '../../data/site';
import { CARTE_CADEAU_FORMULES } from '../../data/cartes-cadeaux';

const title = 'Carte cadeau à préparer | Outil de Caroline';

const formules = CARTE_CADEAU_FORMULES.map((f) => ({
  id: f.id,
  label: f.label,
  montant: f.id === 'libre' ? '' : f.montant,
}));
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap"
    />
    <style>
      @page {
        size: A4 portrait;
        margin: 0;
      }

      @media print {
        .no-print {
          display: none !important;
        }

        body {
          background: white !important;
        }

        #zone-carte {
          position: fixed;
          inset: 0;
          display: flex;
          align-items: center;
          justify-content: center;
          padding: 0 !important;
          background: white !important;
        }

        #carte {
          width: 180mm;
          box-shadow: none !important;
          /* Sans quoi le navigateur retire fonds et bordures à l'impression. */
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }
      }
    </style>
  </head>
  <body class="min-h-dvh bg-sand/60 text-ink">
    <main class="mx-auto max-w-6xl px-4 py-8 md:px-6 md:py-10">
      <header class="no-print">
        <p class="flex items-center gap-2.5 text-xs font-semibold tracking-[0.2em] text-peach-deep uppercase">
          <span class="accent-bar" aria-hidden="true"></span>
          Outil privé
        </p>
        <h1 class="font-display mt-2 text-3xl text-forest md:text-4xl">Préparer une carte cadeau</h1>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink/80">
          Remplissez les champs : la carte se met à jour toute seule. « Imprimer / PDF » ouvre la
          fenêtre d’impression — choisissez « Enregistrer au format PDF » pour obtenir le fichier à
          envoyer. Pour qu’un code fonctionne aussi en réservation en ligne, pensez à le créer dans
          votre outil de réservation.
        </p>
      </header>

      <div class="mt-8 grid gap-8 lg:grid-cols-12">
        <form id="form-carte" class="no-print space-y-4 lg:col-span-4" autocomplete="off">
          <label class="block text-sm">
            <span class="font-medium text-forest">Offerte à</span>
            <input
              id="in-pour"
              placeholder="Prénom (et nom) de la personne"
              class="mt-1.5 w-full rounded-xl border border-line bg-white px-3 py-2.5 outline-none focus:border-forest focus:ring-2 focus:ring-forest/40"
            />
          </label>

          <label class="block text-sm">
            <span class="font-medium text-forest">De la part de</span>
            <input
              id="in-de"
              placeholder="Facultatif"
              class="mt-1.5 w-full rounded-xl border border-line bg-white px-3 py-2.5 outline-none focus:border-forest focus:ring-2 focus:ring-forest/40"
            />
          </label>

          <label class="block text-sm">
            <span class="font-medium text-forest">Formule</span>
            <select
              id="in-formule"
              class="mt-1.5 w-full rounded-xl border border-line bg-white px-3 py-2.5 outline-none focus:border-forest focus:ring-2 focus:ring-forest/40"
            >
              {formules.map((f) => <option value={f.id}>{f.label}</option>)}
            </select>
          </label>

          <label class="block text-sm">
            <span class="font-medium text-forest">Montant affiché</span>
            <input
              id="in-montant"
              placeholder="Ex. : 70 €"
              class="mt-1.5 w-full rounded-xl border border-line bg-white px-3 py-2.5 outline-none focus:border-forest focus:ring-2 focus:ring-forest/40"
            />
            <span class="mt-1 block text-xs text-slate-soft">
              Rempli automatiquement selon la formule ; modifiable librement.
            </span>
          </label>

          <label class="block text-sm">
            <span class="font-medium text-forest">Code de la carte</span>
            <div class="mt-1.5 flex gap-2">
              <input
                id="in-code"
                placeholder="Ex. : CADEAU-7Q4M"
                class="w-full rounded-xl border border-line bg-white px-3 py-2.5 font-mono uppercase outline-none focus:border-forest focus:ring-2 focus:ring-forest/40"
              />
              <button
                type="button"
                id="btn-code"
                class="shrink-0 rounded-xl border border-forest/25 px-3 py-2.5 text-sm font-medium text-forest transition hover:bg-white"
              >
                Générer
              </button>
            </div>
          </label>

          <label class="block text-sm">
            <span class="font-medium text-forest">Validité</span>
            <input
              id="in-validite"
              placeholder="Ex. : valable jusqu’au 3 septembre 2027"
              class="mt-1.5 w-full rounded-xl border border-line bg-white px-3 py-2.5 outline-none focus:border-forest focus:ring-2 focus:ring-forest/40"
            />
          </label>

          <label class="block text-sm">
            <span class="font-medium text-forest">Petit mot sur la carte</span>
            <textarea
              id="in-message"
              rows="3"
              placeholder="Facultatif — le message de la personne qui offre"
              class="mt-1.5 w-full resize-y rounded-xl border border-line bg-white px-3 py-2.5 outline-none focus:border-forest focus:ring-2 focus:ring-forest/40"
            ></textarea>
          </label>

          <button
            type="button"
            id="btn-imprimer"
            class="inline-flex min-h-12 w-full items-center justify-center rounded-full bg-forest px-7 py-3 text-sm font-medium text-white transition hover:bg-forest-deep"
          >
            Imprimer / Enregistrer en PDF
          </button>
        </form>

        <div id="zone-carte" class="lg:col-span-8">
          <div
            id="carte"
            class="mx-auto max-w-2xl rounded-3xl border border-line bg-cream p-3 shadow-lg"
          >
            <div class="rounded-2xl border-2 border-peach/60 px-8 py-10 text-center md:px-12">
              <img src={IMG.monogram} alt="" class="mx-auto h-16 w-16 object-contain" />
              <p class="mt-4 text-xs font-semibold tracking-[0.3em] text-peach-deep uppercase">
                Carte cadeau
              </p>

              <p id="c-pour-ligne" class="font-display mt-5 text-3xl leading-snug text-forest">
                Pour <span id="c-pour">vous</span>
              </p>
              <p id="c-de-ligne" class="mt-2 hidden text-sm text-slate-soft">
                de la part de <span id="c-de"></span>
              </p>

              <div class="mx-auto mt-5 h-px w-16 bg-peach" aria-hidden="true"></div>

              <p id="c-formule" class="font-display mt-5 text-xl text-ink">Un soin énergétique</p>
              <p id="c-montant" class="font-display mt-1 text-4xl text-forest">70 €</p>

              <p id="c-message" class="mx-auto mt-5 hidden max-w-md text-sm leading-relaxed text-ink/75 italic"></p>

              <div
                id="c-code-boite"
                class="mx-auto mt-6 hidden w-fit rounded-xl border-2 border-dashed border-peach bg-white px-6 py-3"
              >
                <p class="text-[0.65rem] font-semibold tracking-[0.2em] text-slate-soft uppercase">
                  Code de la carte
                </p>
                <p id="c-code" class="mt-0.5 font-mono text-lg font-semibold tracking-widest text-forest"></p>
              </div>

              <p id="c-validite" class="mt-4 hidden text-xs text-slate-soft"></p>

              <p class="mt-8 text-xs leading-relaxed text-slate-soft">
                Pour réserver votre séance : {SITE.phone} — je réponds facilement aux SMS.
              </p>
              <p class="font-display mt-3 text-sm text-forest">
                {SITE.name} · {SITE.tagline}
              </p>
              <p class="mt-1 text-xs text-slate-soft">{SITE.fullAddress}</p>
            </div>
          </div>
        </div>
      </div>
    </main>

    <script>
      const formules: Record<string, { label: string; montant: string }> = Object.fromEntries(
        JSON.parse(document.getElementById('formules-data')!.textContent!).map(
          (f: { id: string; label: string; montant: string }) => [f.id, f],
        ),
      );

      const $ = (id: string) => document.getElementById(id)!;
      const input = (id: string) => $(id) as HTMLInputElement;

      /** Affiche `texte` dans `cible`, ou cache `ligne` entière si vide. */
      const poser = (cible: string, ligne: string, texte: string) => {
        $(cible).textContent = texte;
        $(ligne).classList.toggle('hidden', texte === '');
      };

      const rafraichir = () => {
        const pour = input('in-pour').value.trim();
        $('c-pour').textContent = pour || 'vous';
        poser('c-de', 'c-de-ligne', input('in-de').value.trim());

        const formule = formules[input('in-formule').value];
        $('c-formule').textContent = formule
          ? formule.id === 'libre'
            ? 'À utiliser sur la séance de votre choix'
            : `${formule.label === 'Soin énergétique' ? 'Un soin énergétique' : 'Une séance ' + formule.label.toLowerCase()}`
          : '';
        poser('c-montant', 'c-montant', input('in-montant').value.trim());

        poser('c-message', 'c-message', input('in-message').value.trim());
        poser('c-code', 'c-code-boite', input('in-code').value.trim().toUpperCase());
        poser('c-validite', 'c-validite', input('in-validite').value.trim());
      };

      // La formule pré-remplit le montant (modifiable ensuite à la main).
      $('in-formule').addEventListener('change', () => {
        const f = formules[input('in-formule').value];
        if (f) input('in-montant').value = f.montant;
        rafraichir();
      });

      for (const id of ['in-pour', 'in-de', 'in-montant', 'in-code', 'in-validite', 'in-message']) {
        $(id).addEventListener('input', rafraichir);
      }

      // Code lisible au téléphone : pas de 0/O ni de 1/I.
      $('btn-code').addEventListener('click', () => {
        const alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
        const tirage = crypto.getRandomValues(new Uint32Array(4));
        const suffixe = Array.from(tirage, (n) => alphabet[n % alphabet.length]).join('');
        input('in-code').value = `CADEAU-${suffixe}`;
        rafraichir();
      });

      $('btn-imprimer').addEventListener('click', () => window.print());

      const f = formules[input('in-formule').value];
      if (f) input('in-montant').value = f.montant;
      rafraichir();
    </script>
    <script id="formules-data" type="application/json" set:html={JSON.stringify(formules)} />
  </body>
</html>
