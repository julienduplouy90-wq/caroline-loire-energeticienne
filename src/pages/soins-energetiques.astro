---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { IMG, PRICES, RYTHME_CONSEILLE, SITE, u, asset } from '../data/site';
import { TRACK, systemeHref } from '../data/systeme';
import page from '../data/pages/soins-energetiques.json';

const title = 'Soins énergétiques à Bagnères-de-Bigorre | Caroline Loire';
const description =
  `Soin énergétique personnalisé à Bagnères-de-Bigorre ou à distance. Reiki, Shamballa et LaHoChi associés selon vos besoins. Tarif ${PRICES.soin.full} €, solidaire ${PRICES.soin.solidaire} €.`;

/*
 * Ce que peut apporter un soin énergétique suivi dans le temps (demande de
 * Caroline, août 2026 : jusqu'ici sa communication ne parlait que du soin
 * « en cas de crise »). Ton volontairement non commercial : aucune promesse
 * de résultat, aucun forfait, aucune fréquence imposée.
 */
const regularite = [
  {
    t: 'Entretenir l’équilibre',
    d: 'Plutôt que de rattraper une surcharge accumulée pendant des mois, on l’accompagne au fur et à mesure, tant qu’elle est encore légère.',
  },
  {
    t: 'Mieux se connaître',
    d: 'Au fil des séances, on repère plus vite ce qui pèse et ce qui fait du bien. C’est souvent là que les choses bougent vraiment.',
  },
  {
    t: 'Traverser les périodes chargées',
    d: 'Quand la vie s’accélère, un rendez-vous déjà posé dans l’agenda devient un point d’appui — un endroit où déposer.',
  },
  {
    t: 'Un temps qui vous appartient',
    d: 'Une heure pour vous, sans rien avoir à prouver ni à expliquer. C’est souvent la première chose que l’on sacrifie, et la plus précieuse.',
  },
];

const outils = [
  ['/reiki', 'Reiki'],
  ['/shamballa', 'Shamballa'],
  ['/lahochi', 'LaHoChi'],
  ['/lithotherapie', 'Lithothérapie'],
  ['/oracles', 'Oracles'],
];
---

<BaseLayout title={title} description={description} image={IMG.soin}>
  <PageHero
    eyebrow={page.surtitre}
    title={page.titre}
    text={page.texte}
    image={asset(page.photo)}
    imageAlt={page.photoAlt}
  />

  <section class="px-4 py-14 md:px-6 md:py-16">
    <div class="mx-auto grid max-w-6xl gap-10 md:grid-cols-12">
      <div class="space-y-5 text-base leading-relaxed text-ink/85 md:col-span-7">
        <h2 class="font-display text-2xl text-forest md:text-3xl">
          En quoi consiste un soin énergétique ?
        </h2>
        <p>
          Lors d’une séance, j’associe de manière intuitive plusieurs outils — notamment le Reiki, le
          Shamballa et le LaHoChi — selon ce que vous traversez et ce que je ressens. L’objectif n’est
          pas d’appliquer une technique unique, mais de créer un espace d’écoute et de recentrage
          adapté à vous.
        </p>
        <h3 class="font-display pt-2 text-xl text-forest">Déroulement</h3>
        <ol class="list-decimal space-y-2 pl-5 marker:font-semibold marker:text-peach-deep">
          <li>Temps d’échange sur ce qui vous amène.</li>
          <li>
            Un scanner énergétique : je passe le long du corps et je ressens l’état de vos
            chakras.
          </li>
          <li>Installation habillé(e) sur la table de soin, dans le calme.</li>
          <li>Transmission d’énergies selon mes ressentis.</li>
          <li>
            Retour en fin de séance ; le tirage d’une carte d’oracle peut clôturer le temps
            ensemble.
          </li>
        </ol>

        <h3 class="font-display pt-2 text-xl text-forest">Pour qui ?</h3>
        <p>
          Adultes et enfants. Utile notamment en période de fatigue émotionnelle, de surcharge, de
          transition, ou simplement lorsqu’il devient nécessaire de prendre un temps pour soi.
        </p>
      </div>

      <aside class="md:col-span-5">
        <div
          class="sticky top-28 rounded-3xl border border-line border-t-2 border-t-peach bg-white p-6 shadow-sm"
        >
          <p
            class="flex items-center gap-2.5 text-xs font-semibold tracking-[0.18em] text-peach-deep uppercase"
          >
            <span class="accent-bar" aria-hidden="true"></span>
            Formule
          </p>
          <p class="font-display mt-3 text-3xl text-forest">{PRICES.soin.full} €</p>
          <p class="text-sm text-slate-soft">ou {PRICES.soin.solidaire} € en tarif solidaire</p>
          <ul class="mt-5 space-y-2 text-sm text-ink/80">
            <li>Durée : {PRICES.soin.duration}</li>
            <li>Présentiel à Bagnères-de-Bigorre</li>
            <li>À distance possible</li>
            <li>Enfant : {PRICES.soinEnfant.full} € ({PRICES.soinEnfant.duration})</li>
          </ul>
          <a
            href={systemeHref(['energeticSession', 'booking'], SITE.bookingPath, 'page-soins')}
            data-track={TRACK.booking}
            data-track-label="page-soins"
            class="mt-6 flex min-h-12 items-center justify-center rounded-full bg-forest text-sm font-medium text-white transition hover:bg-forest-deep"
          >
            Réserver un soin énergétique
          </a>
          <a
            href={SITE.phoneHref}
            class="mt-3 flex min-h-12 items-center justify-center rounded-full border border-forest/25 text-sm font-medium text-forest transition hover:border-forest/45 hover:bg-sand"
          >
            Ou appeler le {SITE.phone}
          </a>
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-sand/50 px-4 py-12 md:px-6">
    <div class="mx-auto max-w-6xl">
      <h2 class="font-display text-2xl text-forest">Outils pouvant être associés</h2>
      <p class="mt-3 max-w-2xl text-sm text-slate-soft">
        Ces approches font partie du même soin : j’y fais appel selon ce que je ressens sur le
        moment.
      </p>
      <div class="mt-6 flex flex-wrap gap-2">
        {
          outils.map(([to, label]) => (
            <a
              href={u(to)}
              class="rounded-full border border-peach/40 bg-white px-4 py-2 text-sm text-forest transition hover:border-peach hover:bg-peach/20"
            >
              {label}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- RÉGULARITÉ -->
  <section class="px-4 py-14 md:px-6 md:py-16">
    <div class="mx-auto max-w-6xl">
      <div data-reveal>
        <span class="accent-bar mb-4" aria-hidden="true"></span>
        <h2 class="font-display max-w-2xl text-2xl font-semibold text-forest md:text-3xl">
          Une séance fait du bien. Plusieurs ouvrent un chemin.
        </h2>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink/80">
          On pense souvent au soin énergétique quand quelque chose ne va plus : une fatigue qui
          dure, une émotion qui prend toute la place, une période qui pèse. C’est légitime — et
          c’est souvent comme cela que l’on se rencontre.
        </p>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink/80">
          Mais ce qui se met en mouvement pendant une séance continue de travailler les jours
          suivants. Quand quelque chose demande vraiment à se dénouer, cela se joue rarement en une
          fois : c’est en revenant, à quelques semaines d’intervalle, que le chemin se dessine et
          que les effets s’installent. C’est pourquoi je vous invite à penser l’accompagnement en
          plusieurs rendez-vous plutôt qu’en une seule visite.
        </p>

        {
          RYTHME_CONSEILLE && (
            <p class="mt-6 flex max-w-2xl items-start gap-3 rounded-2xl border border-peach/45 bg-peach/15 px-5 py-4 text-base leading-relaxed text-ink/85">
              <svg
                class="mt-1 h-5 w-5 shrink-0 text-peach-deep"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7v5l3.2 2" />
              </svg>
              <span>
                <strong class="font-semibold text-forest">Ce que je conseille :</strong>{' '}
                {RYTHME_CONSEILLE}
              </span>
            </p>
          )
        }
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 md:mt-10">
        {
          regularite.map((r) => (
            <div
              class="h-full rounded-2xl border border-line border-l-2 border-l-peach bg-white p-5 shadow-sm md:p-6"
              data-reveal
            >
              <h3 class="font-display text-xl text-forest">{r.t}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-soft">{r.d}</p>
            </div>
          ))
        }
      </div>

      <p class="mt-8 max-w-2xl text-base leading-relaxed text-ink/80">
        Il n’y a ni forfait, ni abonnement, ni engagement : revenir reste toujours votre choix. Le
        rythme se décide ensemble, et il change avec les saisons de votre vie. Certaines personnes
        reviennent quelques fois dans l’année, d’autres après une étape importante. Nous en parlons
        simplement à la fin de la séance.
      </p>
    </div>
  </section>

  <CtaBand
    title="Envie d’un temps pour vous recentrer ?"
    text="Réservez votre soin énergétique en quelques clics. Un doute sur la formule ? Appelez-moi, on en parle."
    primaryLabel="Réserver un soin énergétique"
    primaryKey={['energeticSession', 'booking']}
  />
</BaseLayout>
