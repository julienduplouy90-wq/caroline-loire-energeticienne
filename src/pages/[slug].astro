---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { RESOURCES_CONTENT } from '../data/resources';
import { u } from '../data/site';

export function getStaticPaths() {
  return RESOURCES_CONTENT.map((resource) => ({
    params: { slug: resource.slug },
    props: { resource },
  }));
}

const { resource } = Astro.props;
---

<BaseLayout title={resource.title} description={resource.description} image={resource.image}>
  <PageHero
    eyebrow="Ressource"
    title={resource.h1}
    text={resource.intro}
    image={resource.image}
    imageAlt={resource.imageAlt}
  />

  <section class="px-4 py-14 md:px-6 md:py-16">
    <div class="mx-auto max-w-3xl space-y-10">
      {
        resource.sections.map((s) => (
          <div data-reveal>
            <span class="accent-bar mb-3" aria-hidden="true" />
            <h2 class="font-display text-2xl text-forest">{s.title}</h2>
            {s.paragraphs.map((p) => (
              <p class="mt-3 text-base leading-relaxed text-ink/85">{p}</p>
            ))}
          </div>
        ))
      }

      <div class="flex flex-wrap gap-3">
        <a
          href={u(resource.primaryCta.to)}
          class="inline-flex min-h-11 items-center rounded-full bg-forest px-5 py-2.5 text-sm font-medium text-white transition hover:bg-forest-deep"
        >
          {resource.primaryCta.label}
        </a>
        <a
          href={u('/contact')}
          class="inline-flex min-h-11 items-center rounded-full border border-forest/25 px-5 py-2.5 text-sm font-medium text-forest hover:bg-sand"
        >
          Prendre contact
        </a>
      </div>
    </div>
  </section>

  <CtaBand
    title="Envie d’un accompagnement personnalisé ?"
    text="Le Reiki et les autres outils présentés ici s’intègrent le plus souvent dans un soin énergétique ou une séance de chamanisme."
    primaryLabel={resource.primaryCta.label}
    primaryTo={resource.primaryCta.to}
    primaryKey={null}
    primaryTrack={null}
  />
</BaseLayout>
