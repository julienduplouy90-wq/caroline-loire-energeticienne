---
import BaseLayout from '../layouts/BaseLayout.astro';
import { NAV, u } from '../data/site';

const title = 'Page introuvable | Caroline Loire';
const description = 'Cette page n’existe pas ou a été déplacée.';
---

<BaseLayout title={title} description={description}>
  <section class="mx-auto max-w-3xl px-4 pt-32 pb-24 text-center md:px-6">
    <span class="accent-bar mb-5" aria-hidden="true"></span>
    <p class="text-xs font-semibold tracking-[0.2em] text-peach-deep uppercase">Erreur 404</p>
    <h1 class="font-display mt-3 text-3xl font-semibold text-forest md:text-5xl">
      Cette page n’existe pas ou a été déplacée
    </h1>
    <p class="mt-5 text-base leading-relaxed text-ink/80">
      Pas d’inquiétude : voici les pages principales du site.
    </p>
    <ul class="mt-8 flex flex-wrap justify-center gap-2">
      {
        NAV.map((item) => (
          <li>
            <a
              href={u(item.to)}
              class="inline-flex rounded-full border border-forest/25 bg-white px-4 py-2 text-sm font-medium text-forest transition hover:bg-sand"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
