---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { IMG, SITE, u, asset } from '../data/site';
import page from '../data/pages/a-propos.json';

const title = 'À propos de Caroline Loire | Énergéticienne Bagnères-de-Bigorre';
const description =
  'Parcours de Caroline Loire, énergéticienne, praticienne en chamanisme et maître Reiki enseignante à Bagnères-de-Bigorre, Hautes-Pyrénées.';

const qualifications = [
  'Maître Reiki praticienne',
  'Maître Reiki enseignante',
  'Praticienne en chamanisme',
  'Praticienne en hypnose ericksonienne',
  'Formations : lithothérapie, Shamballa, LaHoChi',
  'Cabinet à Bagnères-de-Bigorre',
];
---

<BaseLayout title={title} description={description} image={IMG.caroline}>
  <PageHero
    eyebrow={page.surtitre}
    title={page.titre}
    text={page.texte}
    image={asset(page.photo)}
    imageAlt={page.photoAlt}
  />

  <section class="px-4 py-14 md:px-6 md:py-16">
    <div class="mx-auto grid max-w-6xl gap-12 md:grid-cols-2">
      <div class="space-y-5 text-base leading-relaxed text-ink/85">
        <h2 class="font-display text-2xl text-forest md:text-3xl">Mon chemin</h2>
        <p>
          Dès 2006, la danse, le yoga et la méditation ont éveillé en moi une énergie puissante. Cette
          expérience m’a révélé la présence d’une force vitale circulant en chacun de nous, et a
          marqué le début de mon voyage dans l’univers des soins énergétiques.
        </p>
        <p>
          Fascinée par les liens entre corps, émotions et esprit, je me suis d’abord formée au Reiki.
          Au fil des années, j’ai élargi mes connaissances : chamanisme, Shamballa, lithothérapie,
          Fleurs de Bach, LaHoChi, et plus récemment l’hypnose ericksonienne. Ces outils m’ont permis
          d’affiner ma sensibilité et de développer une vision globale de l’équilibre.
        </p>
        <p>
          Aujourd’hui, j’accueille au cabinet à Bagnères-de-Bigorre — et à distance pour certaines
          séances — les personnes qui traversent une fatigue émotionnelle, une transition, un besoin
          de se recentrer, ou l’envie d’apprendre le Reiki.
        </p>
      </div>
      <div>
        <div class="overflow-hidden rounded-3xl ring-1 ring-line" data-reveal>
          <img
            src={IMG.salon}
            alt="Espace d’accueil du cabinet"
            class="aspect-[4/3] w-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          {
            qualifications.map((item) => (
              <div class="rounded-xl border border-line border-l-2 border-l-peach bg-white px-4 py-3 text-sm text-forest">
                {item}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="bg-sand/50 px-4 py-12 md:px-6">
    <div class="mx-auto max-w-6xl">
      <span class="accent-bar mb-4" aria-hidden="true"></span>
      <h2 class="font-display text-2xl text-forest">Le cabinet</h2>
      <p class="mt-3 max-w-2xl text-base text-ink/80">
        Un espace lumineux et simple, pensé pour vous sentir accueilli(e) dès l’entrée. Adresse : {
          SITE.fullAddress
        }.
      </p>
      <div class="mt-8 overflow-hidden rounded-3xl ring-1 ring-line" data-reveal>
        <img
          src={IMG.cabinet}
          alt="Salle de soin du cabinet à Bagnères-de-Bigorre"
          class="aspect-[21/9] w-full object-cover"
          loading="lazy"
        />
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={u('/soins-energetiques')}
          class="rounded-full bg-forest px-5 py-2.5 text-sm font-medium text-white transition hover:bg-forest-deep"
        >
          Soins énergétiques
        </a>
        <a
          href={u('/chamanisme')}
          class="rounded-full border border-forest/25 px-5 py-2.5 text-sm font-medium text-forest hover:bg-white"
        >
          Chamanisme
        </a>
        <a
          href={u('/formations-reiki')}
          class="rounded-full border border-forest/25 px-5 py-2.5 text-sm font-medium text-forest hover:bg-white"
        >
          Formations Reiki
        </a>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
